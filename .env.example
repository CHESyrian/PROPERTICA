# PROPERTICA — example environment file
# Copy to .env and fill in real values.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# false = SQLite (default for local). true = PostgreSQL below.
USE_POSTGRES=false

POSTGRES_DB=propertica_db
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DEFAULT_FROM_EMAIL=

# Search backend: db (default) | opensearch
SEARCH_BACKEND=db
OPENSEARCH_URL=

# Optional Redis cache / rate limits
# REDIS_URL=redis://127.0.0.1:6379/1

# S3-compatible media storage (optional)
USE_S3=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=us-east-1

FEATURED_DURATION_DAYS=14
